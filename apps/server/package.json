{
  "name": "@e-agent/server",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --sourcemap --clean --external @e-agent/ai-runtime --external @e-agent/config --external @e-agent/contracts --external @e-agent/core --external @e-agent/database --external @e-agent/observability --external @e-agent/plugin-runtime --external @e-agent/security --external @e-agent/skills --external fastify --external @fastify/cors --external @fastify/helmet --external @fastify/rate-limit --external zod",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@e-agent/ai-runtime": "workspace:*",
    "@e-agent/config": "workspace:*",
    "@e-agent/contracts": "workspace:*",
    "@e-agent/core": "workspace:*",
    "@e-agent/database": "workspace:*",
    "@e-agent/observability": "workspace:*",
    "@e-agent/plugin-runtime": "workspace:*",
    "@e-agent/security": "workspace:*",
    "@e-agent/skills": "workspace:*",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
