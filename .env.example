# 复制为 .env.local 使用。任何真实密钥都不要提交到版本库。
NODE_ENV=development
E_AGENT_HOST=127.0.0.1
E_AGENT_PORT=4318
E_AGENT_DATABASE_URL=./data/e-agent.db
E_AGENT_LOG_LEVEL=info
E_AGENT_LOG_DIR=./logs
E_AGENT_SESSION_SECRET=replace-with-at-least-32-random-characters
E_AGENT_MASTER_KEY=
E_AGENT_BOOTSTRAP_TOKEN=
E_AGENT_ALLOWED_ORIGINS=http://localhost:5173
E_AGENT_PROVIDER_BASE_URL=https://api.openai.com/v1
E_AGENT_DEFAULT_MODEL=
E_AGENT_OLLAMA_URL=http://127.0.0.1:11434
E_AGENT_SMTP_HOST=
E_AGENT_SMTP_PORT=587
E_AGENT_SMTP_USERNAME=
E_AGENT_SMTP_PASSWORD=
E_AGENT_OTEL_EXPORTER_URL=
E_AGENT_AUTH_DISABLED=false
VITE_E_AGENT_API_URL=http://127.0.0.1:4318

# 真实 Provider 冒烟测试（只通过进程环境注入真实密钥）
E_AGENT_PROVIDER_SMOKE_BASE_URL=https://api.example.com/v1
E_AGENT_PROVIDER_SMOKE_API_KEY=
E_AGENT_PROVIDER_SMOKE_MODEL=example-model
