{
  "name": "e-agent",
  "version": "0.1.2",
  "private": true,
  "description": "生产级桌面端与 Web 端双模 AI 编程助手平台",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:desktop": "pnpm --filter @e-agent/desktop dev",
    "dev:web": "pnpm --filter @e-agent/web dev",
    "dev:server": "pnpm --filter @e-agent/server dev",
    "build": "node build.js",
    "build:icons": "node scripts/assets/generate-icons.mjs",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:apps": "turbo run build --filter='./apps/*'",
    "package:desktop": "pnpm --filter @e-agent/desktop package",
    "validate:installer": "node scripts/ci/validate-desktop-installer.mjs",
    "verify:desktop-package": "node scripts/smoke/verify-desktop-package.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/build/prepare-node-native.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "node scripts/test/run-coverage-gates.mjs",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web",
    "test:e2e:desktop": "node scripts/test/run-desktop-e2e.mjs",
    "smoke:mcp": "pnpm --filter @e-agent/mcp-runtime build && node scripts/smoke/smoke-mcp.mjs",
    "smoke:provider": "pnpm --filter @e-agent/ai-runtime build && node scripts/smoke/smoke-provider.mjs",
    "db:generate": "pnpm --filter @e-agent/database db:generate",
    "db:migrate": "pnpm --filter @e-agent/database db:migrate",
    "db:seed": "pnpm --filter @e-agent/database db:seed",
    "clean": "turbo run clean",
    "prepare": "node scripts/setup/install-hooks.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.1.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.4.21",
    "esbuild": "0.28.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "simple-git-hooks": "2.13.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.1",
    "turbo": "2.5.5",
    "typescript": "5.9.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/setup/run-git-hook.mjs pre-commit",
    "pre-push": "node scripts/setup/run-git-hook.mjs pre-push"
  }
}
